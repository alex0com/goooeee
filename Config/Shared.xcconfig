// Build settings shared by every configuration of the goooeee app target.

MACOSX_DEPLOYMENT_TARGET = 26.0
// The app target builds in Swift 5 mode with targeted concurrency checking: UI code is marked
// @MainActor explicitly, and AppKit/SwiftTerm delegate callbacks don't need Swift 6 workarounds.
// GoooeeeKit (the package) builds in Swift 6 mode with complete checking.
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
ENABLE_USER_SCRIPT_SANDBOXING = YES
GENERATE_INFOPLIST_FILE = NO
INFOPLIST_FILE = App/Resources/Info.plist
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
PRODUCT_NAME = goooeee
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
COMBINE_HIDPI_IMAGES = YES
DEAD_CODE_STRIPPING = YES

#include "Signing.xcconfig"
